# Copy this file to .env and fill in the values.

# --- Security ---
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-please

# --- Database ---
# Default is a local SQLite file (zero setup). docker-compose provides Postgres.
DATABASE_URL=sqlite+aiosqlite:///./docuchat.db
# DATABASE_URL=postgresql+asyncpg://docuchat:docuchat@localhost:5432/docuchat

# --- LLM (OpenAI-compatible: any provider/gateway that speaks the OpenAI API) ---
# Required for chat answers. Works with OpenAI, Groq, Together, OpenRouter, a
# local server, etc. Point LLM_BASE_URL at your provider and set your key + model.
LLM_API_KEY=
LLM_BASE_URL=https://api.justwoker.icu/v1
LLM_MODEL=gpt-4o-mini

# --- Embeddings ---
# Set to 1 to use dependency-light deterministic embeddings (used by the test suite).
# Leave 0 to use a real local embedding model (downloaded on first run).
USE_FAKE_EMBEDDINGS=0
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
